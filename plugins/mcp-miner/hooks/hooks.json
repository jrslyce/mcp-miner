{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c call \"%PLUGIN_ROOT%\\bin\\mcp-miner.exe\" hook session_start",
            "timeout": 10,
            "statusMessage": "Powering MCP Miner"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c call \"%PLUGIN_ROOT%\\bin\\mcp-miner.exe\" hook user_prompt_submit",
            "timeout": 10,
            "statusMessage": "Scanning asteroid work signal"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c call \"%PLUGIN_ROOT%\\bin\\mcp-miner.exe\" hook subagent_start",
            "timeout": 10,
            "statusMessage": "Tagging MCP Miner agent shift"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c call \"%PLUGIN_ROOT%\\bin\\mcp-miner.exe\" hook subagent_stop",
            "timeout": 10,
            "statusMessage": "Closing MCP Miner agent shift"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c call \"%PLUGIN_ROOT%\\bin\\mcp-miner.exe\" hook post_tool_use",
            "timeout": 10,
            "statusMessage": "Mining Codex work"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /d /c call \"%PLUGIN_ROOT%\\bin\\mcp-miner.exe\" hook stop",
            "timeout": 10,
            "statusMessage": "Preparing MCP Miner report"
          }
        ]
      }
    ]
  }
}
